# 复制本文件为 backend/.env 并填入真实值;.env 已被 gitignore,不要提交

# DeepSeek API Key(必填;留空时 /api/chat 返回 503)
DEEPSEEK_API_KEY=

# DeepSeek 模型名,按控制台当前可用模型填写(deepseek-chat / deepseek-reasoner)
DEEPSEEK_MODEL=deepseek-chat

# 访问令牌:至少 16 字符随机串
# 生成:python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_BEARER_TOKEN=

# 额外允许的跨域来源(逗号分隔)。前端与后端同源托管,一般无需配置
ALLOWED_ORIGINS=

# 单条消息最大字符数
MAX_MESSAGE_CHARS=4000
# 单次请求最多携带的历史消息条数
MAX_HISTORY_MESSAGES=20
# 模型输出 token 上限
MAX_OUTPUT_TOKENS=2048
# 上游请求超时(秒)
UPSTREAM_TIMEOUT_SECONDS=60
# 每个 IP 每分钟最大请求数
RATE_LIMIT_PER_MINUTE=30
# 同时进行的上游请求数上限
MAX_CONCURRENT_REQUESTS=2
